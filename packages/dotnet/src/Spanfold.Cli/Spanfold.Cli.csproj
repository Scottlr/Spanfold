<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Spanfold.Cli</PackageId>
    <Authors>Spanfold contributors</Authors>
    <Description>Command-line fixture and audit workflows for Spanfold.</Description>
    <PackageProjectUrl>https://github.com/Scottlr/spanfold</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Scottlr/Spanfold</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2026 Spanfold contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>spanfold;cli;fixtures;audit</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Fix NuGet package README logo rendering.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>spanfold</ToolCommandName>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <ProjectReference Include="../Spanfold/Spanfold.csproj" />
    <ProjectReference Include="../Spanfold.Artifacts/Spanfold.Artifacts.csproj" />
    <ProjectReference Include="../Spanfold.Testing/Spanfold.Testing.csproj" />
  </ItemGroup>

</Project>
